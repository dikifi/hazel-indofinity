{
  "name": "hazel-server",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Lightweight update server for Electron apps, running on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "format": "prettier --write lib test"
  },
  "license": "MIT",
  "repository": "vercel/hazel",
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "trailingComma": "none",
    "arrowParens": "avoid"
  },
  "dependencies": {
    "date-fns": "1.29.0",
    "express-useragent": "1.0.12",
    "semver": "5.5.0"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "wrangler": "4.168.0"
  }
}
